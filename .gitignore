# Python
__pycache__/
*.py[cod]
.venv/
venv/
# cached environments built by ChronoGate.command / ChronoGate.app
.run-venv*/
*.egg-info/
build/
dist/

# macOS
.DS_Store

# ChronoGate outputs
chronogate_exports/
*_gated_raw.tif
*_gated_color.png
*_provenance.json

# Large raw data / instrument scans (GB-scale; kept local, never version-controlled).
# Match by extension anywhere in the tree so a sample dropped in any folder — or a
# downloaded validation file — can never be committed by accident.
3_FLIM_stack_ptu/
*.sptw/
*.ptu
*.sdt
*.phu
*.spc
*.pt3
*.ptw
# Report/export rasters and per-pixel tables can also be large.
*_selection_mask.tif
*_pixels.csv

# App-bundle launch log
.chronogate-launch.log

# Staged USB/offline deployment folder: built installers (~68 MB each) plus the
# generated SOP PDF. All of it is reproducible -- the installers come from a
# GitHub release, the PDF from docs/sop/build.py -- so none of it belongs in git.
ChronoGate-USB/
